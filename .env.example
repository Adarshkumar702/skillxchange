# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillxchange?schema=public"

# Caching & Sockets
REDIS_URL="redis://localhost:6379"

# Server Ports & CORS
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://skillxchange-web.vercel.app"

# Security & JWT Secrets
JWT_SECRET="super-secret-access-token-key-skillxchange-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-skillxchange-2026"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# AI Provider Configuration (Options: "gemini", "openai", "mock")
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Cloudinary / File Storage (Optional)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="123456789"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz"
