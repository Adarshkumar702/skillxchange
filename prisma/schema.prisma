// Prisma Schema for SkillXchange PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
  COMPANY
  ADMIN
}

enum SkillType {
  TEACHING
  LEARNING
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SwapStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SWAP_REQUEST
  SWAP_ACCEPTED
  SWAP_REJECTED
  NEW_MESSAGE
  SESSION_REMINDER
  EXCHANGE_COMPLETED
  RATING_RECEIVED
  AI_RECOMMENDATION
  ACHIEVEMENT_UNLOCKED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum TargetRoleImportance {
  CRITICAL
  IMPORTANT
  DESIRABLE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile             Profile?
  refreshTokens       RefreshToken[]
  skills              UserSkill[]
  sentSwapRequests    SwapRequest[]        @relation("SenderSwaps")
  receivedSwapRequests SwapRequest[]       @relation("ReceiverSwaps")
  conversationMembers ConversationMember[]
  messages            Message[]
  createdSessions     LearningSession[]
  givenRatings        Rating[]             @relation("GivenRatings")
  receivedRatings     Rating[]             @relation("ReceivedRatings")
  achievements        UserAchievement[]
  notifications       Notification[]
  reportsSubmitted    Report[]             @relation("ReporterReports")
  aiRecommendations   AiRecommendation[]
  placementReadiness  PlacementReadiness[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  fullName           String
  avatarUrl          String?
  bio                String?
  university         String
  course             String
  graduationYear     Int
  location           String?
  githubUrl          String?
  linkedinUrl        String?
  portfolioUrl       String?
  availability       String?  @default("Evenings & Weekends")
  reputationScore    Float    @default(5.0)
  completedExchanges Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([university])
  @@index([graduationYear])
  @@index([reputationScore])
}

model SkillCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  skills Skill[]
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  categoryId  String
  description String?
  difficulty  ProficiencyLevel @default(BEGINNER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userSkills UserSkill[]
  offeredInSwaps SwapRequest[] @relation("OfferedSkill")
  requestedInSwaps SwapRequest[] @relation("RequestedSkill")
  careerRoleSkills CareerRoleSkill[]

  @@index([categoryId])
  @@index([name])
}

model UserSkill {
  id              String           @id @default(uuid())
  userId          String
  skillId         String
  type            SkillType
  proficiency     ProficiencyLevel @default(INTERMEDIATE)
  yearsExperience Float            @default(1.0)
  createdAt       DateTime         @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, type])
  @@index([userId])
  @@index([skillId])
  @@index([type])
}

model SwapRequest {
  id               String     @id @default(uuid())
  senderId         String
  receiverId       String
  offeredSkillId   String
  requestedSkillId String
  message          String
  status           SwapStatus @default(PENDING)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sender         User   @relation("SenderSwaps", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User   @relation("ReceiverSwaps", fields: [receiverId], references: [id], onDelete: Cascade)
  offeredSkill   Skill  @relation("OfferedSkill", fields: [offeredSkillId], references: [id], onDelete: Restrict)
  requestedSkill Skill  @relation("RequestedSkill", fields: [requestedSkillId], references: [id], onDelete: Restrict)

  conversation     Conversation?
  learningSessions LearningSession[]
  learningProgress LearningProgress?
  ratings          Rating[]

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model Conversation {
  id            String   @id @default(uuid())
  swapRequestId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  swapRequest SwapRequest          @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    Message[]
}

model ConversationMember {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  mediaUrl       String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model LearningSession {
  id              String        @id @default(uuid())
  swapRequestId   String
  createdById     String
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  meetingUrl      String?
  status          SessionStatus @default(SCHEDULED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  swapRequest SwapRequest @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([swapRequestId])
  @@index([scheduledAt])
}

model LearningProgress {
  id                String   @id @default(uuid())
  swapRequestId     String   @unique
  percentage        Float    @default(0.0)
  sessionsCompleted Int      @default(0)
  totalSessions     Int      @default(5)
  notes             String?
  milestonesJson    String?  // JSON string storing milestone check items
  updatedAt         DateTime @updatedAt

  swapRequest SwapRequest @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)
}

model Rating {
  id              String   @id @default(uuid())
  swapRequestId   String
  raterId         String
  rateeId         String
  overall         Float
  teachingQuality Float
  communication   Float
  reliability     Float
  knowledge       Float
  feedback        String?
  createdAt       DateTime @default(now())

  swapRequest SwapRequest @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)
  rater       User        @relation("GivenRatings", fields: [raterId], references: [id], onDelete: Cascade)
  ratee       User        @relation("ReceivedRatings", fields: [rateeId], references: [id], onDelete: Cascade)

  @@unique([swapRequestId, raterId])
  @@index([rateeId])
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  icon        String
  badgeColor  String   @default("indigo")
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  details     String?
  status      ReportStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter User @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reporterId])
}

model CareerRole {
  id            String   @id @default(uuid())
  title         String   @unique
  category      String
  description   String
  averageSalary String   @default("$95,000 / year")
  demandLevel   String   @default("High")
  createdAt     DateTime @default(now())

  skills             CareerRoleSkill[]
  placementReadiness PlacementReadiness[]
}

model CareerRoleSkill {
  id           String               @id @default(uuid())
  careerRoleId String
  skillId      String
  importance   TargetRoleImportance @default(IMPORTANT)

  careerRole CareerRole @relation(fields: [careerRoleId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerRoleId, skillId])
  @@index([careerRoleId])
}

model AiRecommendation {
  id          String   @id @default(uuid())
  userId      String
  type        String   // SKILL, USER, CAREER
  contentJson String   // Structured AI recommendations JSON
  score       Float    @default(0.9)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlacementReadiness {
  id                String   @id @default(uuid())
  userId            String
  careerRoleId      String
  dsaScore          Float    @default(60.0)
  systemDesignScore Float    @default(50.0)
  techStackScore    Float    @default(70.0)
  softSkillsScore   Float    @default(80.0)
  overallScore      Float    @default(65.0)
  updatedAt         DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerRole CareerRole @relation(fields: [careerRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, careerRoleId])
  @@index([userId])
}
